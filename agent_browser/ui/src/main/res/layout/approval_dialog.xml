<?xml version="1.0" encoding="utf-8"?>
<!-- Agent Approvals (spec section 26) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/approval_title"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/approval_website"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/approval_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/approval_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/approval_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/approval_edit" />

        <Button
            android:id="@+id/approval_reject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/approval_reject" />

        <Button
            android:id="@+id/approval_approve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/approval_approve" />
    </LinearLayout>
</LinearLayout>
